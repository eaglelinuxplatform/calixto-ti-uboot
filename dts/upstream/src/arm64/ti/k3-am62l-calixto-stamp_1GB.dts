// SPDX-License-Identifier: GPL-2.0-only or MIT
/*
 * Device Tree file for the AM62L31 custom board modified from the am62l3 Evaluation Module
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/net/ti-dp83867.h>
#include <dt-bindings/thermal/thermal.h>
#include "k3-am62l3.dtsi"
#include "k3-pinctrl.h"

/ {
	compatible = "Calixto,am62l-stamp-som", "ti,am62l3";
	model = "Calixto Systems AM62L3 Stamp SOM 1GB BL";

	aliases {
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
	};

	chosen {
		stdout-path = &main_uart0;
	};

	memory@80000000 {  
		reg = <0x00000000 0x80000000 0x00000000 0x40000000>; /* 1 GB */
		device_type = "memory";
		bootph-all;
	};  
	
	transceiver1: can-phy0 {
		compatible = "ti,tcan1042";
		#phy-cells = <0>;
		max-bitrate = <5000000>;
	};        	
};

&pmx0 {

	j17_exp_con_gpio_pins_default: j17_exp_con_gpio-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0150, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AB12) RGMII2_TX_CTL.GPIO0_67 */
			AM62LX_IOPAD(0x0100, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (U22) MMC2_DAT0.GPIO0_48 */
			AM62LX_IOPAD(0x00fc, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (T22) MMC2_DAT1.GPIO0_47 */
			AM62LX_IOPAD(0x00f8, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (T23) MMC2_DAT2.GPIO0_46 */
			AM62LX_IOPAD(0x00f4, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (R22) MMC2_DAT3.GPIO0_45 */
			AM62LX_IOPAD(0x0104, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (R23) MMC2_CLK.GPIO0_49 */
			AM62LX_IOPAD(0x010c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (U23) MMC2_CMD.GPIO0_50 */
			AM62LX_IOPAD(0x0110, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (T20) MMC2_SDCD.GPIO0_51 */
			AM62LX_IOPAD(0x0114, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (T21) MMC2_SDWP.GPIO0_52 */
		>;
	};
	
	j19_exp_con_gpio_pins_default: j19_exp_con_gpio-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x016c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AC7) RGMII2_RXC.GPIO0_74 */
			AM62LX_IOPAD(0x0168, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AC8) RGMII2_RX_CTL.GPIO0_73 */
			AM62LX_IOPAD(0x0170, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AB9) RGMII2_RD0.GPIO0_75 */
			AM62LX_IOPAD(0x0174, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AC9) RGMII2_RD1.GPIO0_76 */
			AM62LX_IOPAD(0x0178, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AB10) RGMII2_RD2.GPIO0_77 */
			AM62LX_IOPAD(0x017c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AB8) RGMII2_RD3.GPIO0_78 */
			AM62LX_IOPAD(0x0158, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AC12) RGMII2_TD0.GPIO0_69 */
			AM62LX_IOPAD(0x015c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AB13) RGMII2_TD1.GPIO0_70 */
			AM62LX_IOPAD(0x0160, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AA12) RGMII2_TD2.GPIO0_71 */
			AM62LX_IOPAD(0x0164, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (AA13) RGMII2_TD3.GPIO0_72 */
			AM62LX_IOPAD(0x0154, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (Y13) RGMII2_TXC.GPIO0_68 */
		>;
	};
	j12_exp_con_gpio_pins_default: j12_exp_con_gpio-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0060, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (G20) OSPI0_D6.GPIO0_9 */
			AM62LX_IOPAD(0x005c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (F19) OSPI0_D5.GPIO0_8 */
			AM62LX_IOPAD(0x0068, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (C20) OSPI0_CSn0.GPIO0_11 */
			AM62LX_IOPAD(0x0040, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (E18) OSPI0_LBCLKO.GPIO0_1 */
			AM62LX_IOPAD(0x0058, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (F21) OSPI0_D4.GPIO0_7 */
			AM62LX_IOPAD(0x0064, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (F20) OSPI0_D7.GPIO0_10 */
			AM62LX_IOPAD(0x006c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D20) OSPI0_CSn1.GPIO0_12 */
			AM62LX_IOPAD(0x0070, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D18) OSPI0_CSn2.GPIO0_13 */
			AM62LX_IOPAD(0x0048, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (C22) OSPI0_D0.GPIO0_3 */
			AM62LX_IOPAD(0x003c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D22) OSPI0_CLK.GPIO0_0 */
			AM62LX_IOPAD(0x0050, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (E23) OSPI0_D2.GPIO0_5 */
			AM62LX_IOPAD(0x0054, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D23) OSPI0_D3.GPIO0_6 */
			AM62LX_IOPAD(0x01e4, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D16) EXT_REFCLK1.GPIO0_104 */
			AM62LX_IOPAD(0x0074, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (C23) OSPI0_CSn3.GPIO0_14 */
			AM62LX_IOPAD(0x0044, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (E22) OSPI0_DQS.GPIO0_2 */
			AM62LX_IOPAD(0x004c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D21) OSPI0_D1.GPIO0_4 */
			AM62LX_IOPAD(0x01dc, PIN_OUTPUT_PULLUP|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (B8) I2C2_SCL.GPIO0_102 */
			AM62LX_IOPAD(0x01e0, PIN_OUTPUT_PULLUP|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D8) I2C2_SDA.GPIO0_103 */
			AM62LX_IOPAD(0x01d4, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D7) I2C1_SCL.GPIO0_100 */
			AM62LX_IOPAD(0x01d8, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (A6) I2C1_SDA.GPIO0_101 */
		>;
	};
	
	rs485_pins_default: rs485-default-pins {  /* RS485 */
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0198, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 2) /* (C11) MCASP0_AFSR.UART1_RXD */
			AM62LX_IOPAD(0x019c, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 2) /* (A12) MCASP0_ACLKR.UART1_TXD */
			AM62LX_IOPAD(0x0190, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (A11) MCASP0_ACLKX.GPIO0_83 */
		>;
	};
	
	main_can0_pins_default: main_can0-default-pins { /* CAN0 */
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01c8, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (B15) MCAN0_RX */
			AM62LX_IOPAD(0x01c4, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (B16) MCAN0_TX */
		>;
	};
	
	mikrobus_epwm0_pins_default: mikrobus_epwm0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01a4, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 2) /* (D11) SPI0_CS1.EHRPWM0_B */
		>;
	};
	mikrobus_gpio0_pins_default: mikrobus_gpio0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x018c, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (B9) MCASP0_AXR0.GPIO0_82 */
			AM62LX_IOPAD(0x0238, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (D6) MMC1_SDWP.GPIO0_123 */
		>;
	};
	mikrobus_i2c0_pins_default: mikrobus_i2c0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01cc, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (B7) I2C0_SCL */
			AM62LX_IOPAD(0x01d0, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (A7) I2C0_SDA */
		>;
	};
	mikrobus_spi0_pins_default: mikrobus_spi0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01a8, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (E13) SPI0_CLK */
			AM62LX_IOPAD(0x01a0, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (E11) SPI0_CS0 */
			AM62LX_IOPAD(0x01ac, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (E12) SPI0_D0 */
			AM62LX_IOPAD(0x01b0, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (B12) SPI0_D1 */
		>;
	};
	mikrobus_uart4_pins_default: mikrobus_uart4-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x00ec, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 3) /* (M23) GPMC0_CSn2.UART4_RXD */
			AM62LX_IOPAD(0x00f0, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 3) /* (M22) GPMC0_CSn3.UART4_TXD */
		>;
	};
	
	i2c3_pins_default: i2c3-default-pins {
            pinctrl-single,pins = <
                    AM62LX_IOPAD(0x01bc, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 2) /* (B14) UART0_CTSn.I2C3_SCL */
                    AM62LX_IOPAD(0x01c0, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 2) /* (B13) UART0_RTSn.I2C3_SDA */
            >;
        };


	mmc0_pins_default: mmc0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0214, PIN_INPUT, 0) /* (D2) MMC0_CMD */
			AM62LX_IOPAD(0x020c, PIN_OUTPUT, 0) /* (B2) MMC0_CLK */
			AM62LX_IOPAD(0x0208, PIN_INPUT, 0) /* (D3) MMC0_DAT0 */
			AM62LX_IOPAD(0x0204, PIN_INPUT_PULLUP, 0) /* (D4) MMC0_DAT1 */
			AM62LX_IOPAD(0x0200, PIN_INPUT_PULLUP, 0) /* (C1) MMC0_DAT2 */
			AM62LX_IOPAD(0x01fc, PIN_INPUT_PULLUP, 0) /* (C2) MMC0_DAT3 */
			AM62LX_IOPAD(0x01f8, PIN_INPUT_PULLUP, 0) /* (C4) MMC0_DAT4 */
			AM62LX_IOPAD(0x01f4, PIN_INPUT_PULLUP, 0) /* (B3) MMC0_DAT5 */
			AM62LX_IOPAD(0x01f0, PIN_INPUT_PULLUP, 0) /* (A3) MMC0_DAT6 */
			AM62LX_IOPAD(0x01ec, PIN_INPUT_PULLUP, 0) /* (B4) MMC0_DAT7 */
		>;
		bootph-all;
	};

	mmc1_pins_default: mmc1-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0230, PIN_INPUT, 0) /* (Y3) MMC1_CMD */
			AM62LX_IOPAD(0x0228, PIN_OUTPUT, 0) /* (Y2) MMC1_CLK */
			AM62LX_IOPAD(0x0224, PIN_INPUT, 0) /* (AA1) MMC1_DAT0 */
			AM62LX_IOPAD(0x0220, PIN_INPUT, 0) /* (Y4) MMC1_DAT1 */
			AM62LX_IOPAD(0x021c, PIN_INPUT, 0) /* (AA2) MMC1_DAT2 */
			AM62LX_IOPAD(0x0218, PIN_INPUT, 0) /* (AB2) MMC1_DAT3 */
			AM62LX_IOPAD(0x0234, PIN_INPUT, 0) /* (B6) MMC1_SDCD */
		>;
		bootph-all;
	};

	dpi_pins_default: dpi-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x00e4, PIN_OUTPUT, 1) /* (L20) GPMC0_CSn0.VOUT0_VSYNC */
			AM62LX_IOPAD(0x00dc, PIN_OUTPUT, 1) /* (N21) GPMC0_WPn.VOUT0_HSYNC */
			AM62LX_IOPAD(0x00e8, PIN_OUTPUT, 1) /* (L19) GPMC0_CSn1.VOUT0_PCLK */
			AM62LX_IOPAD(0x00e0, PIN_OUTPUT, 1) /* (M21) GPMC0_DIR.VOUT0_DE */
			AM62LX_IOPAD(0x0078, PIN_OUTPUT, 1) /* (L22) GPMC0_AD0.VOUT0_DATA0 */
			AM62LX_IOPAD(0x007c, PIN_OUTPUT, 1) /* (L23) GPMC0_AD1.VOUT0_DATA1 */
			AM62LX_IOPAD(0x0080, PIN_OUTPUT, 1) /* (K22) GPMC0_AD2.VOUT0_DATA2 */
			AM62LX_IOPAD(0x0084, PIN_OUTPUT, 1) /* (J23) GPMC0_AD3.VOUT0_DATA3 */
			AM62LX_IOPAD(0x0088, PIN_OUTPUT, 1) /* (K23) GPMC0_AD4.VOUT0_DATA4 */
			AM62LX_IOPAD(0x008c, PIN_OUTPUT, 1) /* (H22) GPMC0_AD5.VOUT0_DATA5 */
			AM62LX_IOPAD(0x0090, PIN_OUTPUT, 1) /* (H23) GPMC0_AD6.VOUT0_DATA6 */
			AM62LX_IOPAD(0x0094, PIN_OUTPUT, 1) /* (J22) GPMC0_AD7.VOUT0_DATA7 */
			AM62LX_IOPAD(0x0098, PIN_OUTPUT, 1) /* (H19) GPMC0_AD8.VOUT0_DATA8 */
			AM62LX_IOPAD(0x009c, PIN_OUTPUT, 1) /* (H20) GPMC0_AD9.VOUT0_DATA9 */
			AM62LX_IOPAD(0x00a0, PIN_OUTPUT, 1) /* (H21) GPMC0_AD10.VOUT0_DATA10 */
			AM62LX_IOPAD(0x00a4, PIN_OUTPUT, 1) /* (H18) GPMC0_AD11.VOUT0_DATA11 */
			AM62LX_IOPAD(0x00a8, PIN_OUTPUT, 1) /* (G23) GPMC0_AD12.VOUT0_DATA12 */
			AM62LX_IOPAD(0x00ac, PIN_OUTPUT, 1) /* (G22) GPMC0_AD13.VOUT0_DATA13 */
			AM62LX_IOPAD(0x00b0, PIN_OUTPUT, 1) /* (F22) GPMC0_AD14.VOUT0_DATA14 */
			AM62LX_IOPAD(0x00b4, PIN_OUTPUT, 1) /* (F23) GPMC0_AD15.VOUT0_DATA15 */
			AM62LX_IOPAD(0x00b8, PIN_OUTPUT, 1) /* (L21) GPMC0_CLK.VOUT0_DATA16 */
			AM62LX_IOPAD(0x00c0, PIN_OUTPUT, 1) /* (N19) GPMC0_ADVn_ALE.VOUT0_DATA17 */
			AM62LX_IOPAD(0x00c4, PIN_OUTPUT, 1) /* (N20) GPMC0_OEn_REn.VOUT0_DATA18 */
			AM62LX_IOPAD(0x00c8, PIN_OUTPUT, 1) /* (M19) GPMC0_WEn.VOUT0_DATA19 */
			AM62LX_IOPAD(0x00cc, PIN_OUTPUT, 1) /* (P23) GPMC0_BE0n_CLE.VOUT0_DATA20 */
			AM62LX_IOPAD(0x00d0, PIN_OUTPUT, 1) /* (P22) GPMC0_BE1n.VOUT0_DATA21 */
			AM62LX_IOPAD(0x00d4, PIN_OUTPUT, 1) /* (N23) GPMC0_WAIT0.VOUT0_DATA22 */
			AM62LX_IOPAD(0x00d8, PIN_OUTPUT, 1) /* (N22) GPMC0_WAIT1.VOUT0_DATA23 */
		>;
		bootph-all;
	};

	rgmii1_pins_default: rgmii1-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0138, PIN_INPUT, 0) /* (Y8) RGMII1_RD0 */
			AM62LX_IOPAD(0x013c, PIN_INPUT, 0) /* (AA6) RGMII1_RD1 */
			AM62LX_IOPAD(0x0140, PIN_INPUT, 0) /* (AA8) RGMII1_RD2 */
			AM62LX_IOPAD(0x0144, PIN_INPUT, 0) /* (W8) RGMII1_RD3 */
			AM62LX_IOPAD(0x0134, PIN_INPUT, 0) /* (Y7) RGMII1_RXC */
			AM62LX_IOPAD(0x0130, PIN_INPUT, 0) /* (Y6) RGMII1_RX_CTL */
			AM62LX_IOPAD(0x0120, PIN_OUTPUT, 0) /* (AC10) RGMII1_TD0 */
			AM62LX_IOPAD(0x0124, PIN_OUTPUT, 0) /* (W13) RGMII1_TD1 */
			AM62LX_IOPAD(0x0128, PIN_OUTPUT, 0) /* (Y11) RGMII1_TD2 */
			AM62LX_IOPAD(0x012c, PIN_OUTPUT, 0) /* (AA11) RGMII1_TD3 */
			AM62LX_IOPAD(0x011c, PIN_OUTPUT, 0) /* (W11) RGMII1_TXC */
			AM62LX_IOPAD(0x0118, PIN_OUTPUT, 0) /* (AB11) RGMII1_TX_CTL */
		>;
	};

	mdio1_pins_default: mdio1-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x014c, PIN_OUTPUT, 0) /* (AC15) MDIO0_MDC */
			AM62LX_IOPAD(0x0148, PIN_INPUT, 0) /* (AC13) MDIO0_MDIO */
		>;
	};

	uart0_pins_default: uart0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01b4, PIN_INPUT, 0) /* (D13) UART0_RXD */
			AM62LX_IOPAD(0x01b8, PIN_OUTPUT, 0) /* (C13) UART0_TXD */
		>;
		bootph-all;
	};

	uart0_pins_wakeup: uart0-wakeup-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x01b4, PIN_INPUT | PIN_WKUP_EN, 0) /* (D13) UART0_RXD */
			AM62LX_IOPAD(0x01b8, PIN_OUTPUT, 0) /* (C13) UART0_TXD */
		>;
	};
	

	usb1_default_pins: usb1-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0248, PIN_INPUT | PIN_DS_PULLUD_ENABLE | PIN_DS_PULL_UP, 0) /* (A5) USB1_DRVVBUS */
		>;
	};
	
	myusb0_pins_default: myusb0-default-pins {
        	pinctrl-single,pins = <
            		AM62LX_IOPAD(0x0244, PIN_OUTPUT|PIN_DRIVE_STRENGTH_NOMINAL, 0) /* (C6) USB0_DRVVBUS */
        	>;
    	};
    	
    	myusb0_id_pins_default: myusb0-id-default-pins {
        	pinctrl-single,pins = <
            		AM62LX_IOPAD(0x0184, PIN_INPUT|PIN_DRIVE_STRENGTH_NOMINAL, 7) /* (B10) MCASP0_AXR2.GPIO0_80 */ /* CONNECTOR ID PIN */
        	>;
    	};
    	
	wkup_uart0_pins_default: wkup-uart0-default-pins {
		pinctrl-single,pins = <
			AM62LX_IOPAD(0x0000, PIN_INPUT, 0) /* (Y22) WKUP_UART0_RXD */
			AM62LX_IOPAD(0x0004, PIN_OUTPUT, 0) /* (AA23) WKUP_UART0_TXD */
		>;
	};
};

&main_gpio0 {
    	bootph-all;
    	status = "okay";
    	pinctrl-names = "default";
    	pinctrl-0 = <&j17_exp_con_gpio_pins_default  /* Expansion Connector J17 pins muxed as GPIO */
    		     &j19_exp_con_gpio_pins_default  /* Expansion Connector J19 pins muxed as GPIO */
    		     &j12_exp_con_gpio_pins_default  /* Expansion Connector J12 pins muxed as GPIO */
    		     &mikrobus_gpio0_pins_default>;	     /* Mikrobus gpio pins RST INT */   		 
};

&sdhci0 {
	/* eMMC */
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins_default>;
	non-removable;
	status = "okay";
	bootph-all;
};

&sdhci1 {
	/* SD/MMC */
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins_default>;
	/* UHS -> HS */
	/delete-property/ ti,otap-del-sel-sdr12;
    	/delete-property/ ti,otap-del-sel-sdr25;
    	/delete-property/ ti,otap-del-sel-sdr50;
    	/delete-property/ ti,otap-del-sel-ddr50;
    	/delete-property/ ti,otap-del-sel-sdr104;
    	no-1-8-v;
	disable-wp;
	status = "okay";
	bootph-all;
};

&main_pktdma {
	bootph-all;
};

&cpsw3g {
    pinctrl-names = "default";
    pinctrl-0 = <&rgmii1_pins_default>;
    status = "okay";
};

&cpsw3g_mdio {
        status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio1_pins_default>;
	
	cpsw3g_phy0: ethernet-phy@6 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <6>;
	};
};

&cpsw_port1 {
	phy-mode = "rgmii-rxid";
	phy-handle = <&cpsw3g_phy0>;
	status = "okay";
};

/* port 2 not in use */
/delete-node/ &cpsw_port2;

&main_uart0 {
	pinctrl-0 = <&uart0_pins_default>;
	pinctrl-1 = <&uart0_pins_wakeup>;
	pinctrl-names = "default", "wakeup";
	wakeup-source;
	status = "okay";
	bootph-all;
};

&main_uart4 {
	pinctrl-0 = <&mikrobus_uart4_pins_default>; /* Mikrobus UART4 */
	pinctrl-names = "default";
	status = "okay";
	bootph-all;
};

&main_uart1 {
	pinctrl-0 = <&rs485_pins_default>; /* RS485 */
	pinctrl-names = "default";
	status = "okay";
	bootph-all;
};

&main_i2c3 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&i2c3_pins_default>;
        clock-frequency = <400000>;
    
            pcf8563@51 { /* External RTC */
            compatible = "nxp,pcf8563";
            reg = <0x51>;
        };
    
};

&main_i2c0 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&mikrobus_i2c0_pins_default>; /* Mikrobus i2c0 */
        clock-frequency = <400000>; 
};

&main_spi0{
	status = "okay";
	#address-cells = <1>;
        #size-cells = <0>;
        pinctrl-names = "default";
        pinctrl-0 = <&mikrobus_spi0_pins_default>; /* Mikrobus spi0 */
        
        spidev0: spi_device@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};

};

&epwm0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&mikrobus_epwm0_pins_default>; /* Mikrobus epwm0 */
};

&usbss0 {
	status = "okay";
	ti,vbus-divider;
};

&usb0 {
	bootph-all;
	/* dr_mode = "host"; */
	dr_mode = "otg";
	pinctrl-names = "default";	
	pinctrl-0 = <&myusb0_pins_default>;
};

&usbss1 {
	status = "okay";
	ti,vbus-divider;
};

&usb1 {
	dr_mode = "host";
	pinctrl-names = "default";
	pinctrl-0 = <&usb1_default_pins>;
};

&main_mcan0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_can0_pins_default>;
	phys = <&transceiver1>;
	status = "okay";
};

&wkup_uart0 {
	pinctrl-0 = <&wkup_uart0_pins_default>;
	pinctrl-names = "default";
};

&wkup_uart0_interconnect {
	status = "okay";
};
